//@version=6
// SPDX-License-Identifier: MIT
indicator("Smart Money Indicator v1.5 - Tiny Legend Controls", overlay = true, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 300)

//SMI Pine v1.5 is a standalone current-chart-timeframe overlay with valid-quality visibility, tiny/optional legend, and separate visual toggles.
// It is context-only: no entries, no sizing, no orders, no execution.
// TypeScript core remains the canonical backend truth layer.
// Pine sourceTimeframe = current chart timeframe.

//──────────────────────────────────────────────────────────────────────────────
// Inputs
//──────────────────────────────────────────────────────────────────────────────
displayMode = input.string("Clean", "Display mode", options = ["Clean", "Normal", "Debug", "Audit"], group = "Display")
zoneVisibilityMode = input.string("Valid + Quality", "Zone visibility mode", options = ["Valid + Quality", "All valid", "Debug all detected"], group = "Display")
swingLen = input.int(3, "Swing length", minval = 1, group = "Structure")

showStructure = input.bool(true, "Show Structure", group = "Structure")
showSwingLabels = input.bool(true, "Show HH / HL / LH / LL", group = "Structure")

// Main visual toggles. These hide/show visuals only; they do not turn the script into a signal engine.
showFvg = input.bool(true, "Show FVG zones", group = "Visibility")
showOb = input.bool(true, "Show Order Blocks", group = "Visibility")
showOnlyOb = input.bool(false, "Show only Order Blocks", group = "Visibility")
showSellSideSweeps = input.bool(true, "Show SSL sweeps", group = "Visibility")
showBuySideSweeps = input.bool(true, "Show BSL sweeps", group = "Visibility")

showFvgQualityLabels = input.bool(false, "Show FVG quality labels", group = "FVG")
showObLabels = input.bool(true, "Show OB labels", group = "Order Blocks")

showLiquidity = input.bool(true, "Show Liquidity Pools", group = "Liquidity")
showSweeps = input.bool(true, "Show Liquidity Sweeps", group = "Liquidity")
sweepDisplay = input.string("Markers only", "Sweep display", options = ["Off", "Markers only", "Labels"], group = "Liquidity")

showMidpoints = input.bool(true, "Show Midpoints / CE", group = "Zones")
midpointDisplay = input.string("Strong active only", "Midpoint display", options = ["Off", "Strong active only", "All active", "Debug only"], group = "Zones")
showInvalidatedZones = input.bool(false, "Show Invalidated Zones", group = "Zones")
showMitigatedZones = input.bool(false, "Show Mitigated Zones", group = "Zones")
mitigatedThresholdPct = input.float(0.95, "Mitigated threshold", minval = 0.50, maxval = 1.0, step = 0.05, group = "Zones")
maxZoneAgeBars = input.int(365, "Max visible zone age bars (0 = unlimited)", minval = 0, maxval = 3000, group = "Zones")
keepStrongZonesBeyondMaxAge = input.bool(true, "Keep valid strong zones beyond max age", group = "Zones")
showZoneStatusLabels = input.bool(false, "Show zone status labels", group = "Zones")
showContextBadge = input.bool(true, "Show current context badge", group = "Display")

showLegend = input.bool(false, "Show legend", group = "Legend")
legendMode = input.string("Tiny", "Legend mode", options = ["Tiny", "Compact"], group = "Legend")
legendTextSizeInput = input.string("Small", "Legend text size", options = ["Tiny", "Small", "Normal"], group = "Legend")
legendPositionInput = input.string("Top right", "Legend position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = "Legend")

bullFvgColor = input.color(color.lime, "Bullish FVG fill/border", group = "Colors - FVG")
bearFvgColor = input.color(color.red, "Bearish FVG fill/border", group = "Colors - FVG")

// OB uses a clearly different palette from FVG so OB zones do not disappear inside imbalance boxes.
bullObColor = input.color(color.aqua, "Bullish OB border/fill", group = "Colors - Order Blocks")
bearObColor = input.color(color.fuchsia, "Bearish OB border/fill", group = "Colors - Order Blocks")

sellSideSweepColor = input.color(color.lime, "SSL sweep marker", group = "Colors - Sweeps")
buySideSweepColor = input.color(color.red, "BSL sweep marker", group = "Colors - Sweeps")

trapRiskColor = input.color(color.orange, "Trap-risk color", group = "Colors - Quality")
weakZoneColor = input.color(color.gray, "Weak/old zone color", group = "Colors - Quality")

maxFvgZones = input.int(12, "Max FVG zones", minval = 1, maxval = 150, group = "Limits")
maxObZones = input.int(12, "Max OB zones", minval = 1, maxval = 120, group = "Limits")
maxLiquidityLevels = input.int(15, "Max liquidity levels", minval = 1, maxval = 100, group = "Limits")
maxLabels = input.int(40, "Max labels", minval = 10, maxval = 200, group = "Limits")

// FVG geometry vs quality. Geometry creates the zone. Quality only describes it.
atrLen = input.int(14, "ATR length", minval = 1)
minGeometryGapTicks = input.int(1, "Min geometry gap in ticks", minval = 0)
minStrongGapAtr = input.float(0.15, "Strong FVG min size as ATR", minval = 0.0, step = 0.05)

// Middle-candle displacement quality.
minBodyToRangeRatio = input.float(0.60, "Min body/range for displacement", minval = 0.0, maxval = 1.0, step = 0.05)
minRangeAtrMultiple = input.float(1.20, "Min middle candle range as ATR", minval = 0.0, step = 0.05)
minBullCloseLocationPct = input.float(0.70, "Bull displacement close location", minval = 0.0, maxval = 1.0, step = 0.05)
maxBearCloseLocationPct = input.float(0.30, "Bear displacement close location", minval = 0.0, maxval = 1.0, step = 0.05)

// Structure relation quality.
maxCandlesAfterBos = input.int(3, "Max candles after BOS for strong FVG", minval = 0, maxval = 20)

// Nearby barrier/trap-risk visual flag. Uses already visible swing levels only.
useBarrierFlags = input.bool(true, "Flag FVG near visible swing barrier")
barrierMaxDistancePct = input.float(0.35, "Max barrier distance %", minval = 0.0, step = 0.05)

// Order blocks.
minObDisplacementAtr = input.float(0.25, "Min OB displacement as ATR", minval = 0.0, step = 0.05)
obLookback = input.int(15, "OB origin lookback", minval = 1, maxval = 50)

// Lifecycle.
reactionMaxBars = input.int(5, "Reaction max bars after touch", minval = 1, maxval = 50)
reactionMode = input.string("Close beyond midpoint", "Reaction mode", options = ["Close beyond midpoint", "Close outside zone"])
liquidityLineMode = input.string("Active", "Liquidity line mode", options = ["Active", "Historical"])

// Sweep quality/sensitivity. Close-back remains required for canonical sweep.
minSweepDepthTicks = input.int(1, "Min sweep depth in ticks", minval = 0)
minSweepWickToBodyRatio = input.float(0.50, "Min sweep wick/body ratio", minval = 0.0, step = 0.05)

//──────────────────────────────────────────────────────────────────────────────
// Runtime helpers
//──────────────────────────────────────────────────────────────────────────────
atr = ta.atr(atrLen)
confirmedBar = barstate.isconfirmed
isClean = displayMode == "Clean"
isNormal = displayMode == "Normal"
isDebug = displayMode == "Debug"
isAudit = displayMode == "Audit"

effectiveShowSwingLabels = isDebug ? showSwingLabels : isNormal ? showSwingLabels : false
effectiveShowInvalidated = (isDebug or isAudit) ? showInvalidatedZones : isNormal ? showInvalidatedZones : false
effectiveShowZoneStatusLabels = isDebug ? (showZoneStatusLabels or showFvgQualityLabels) : isAudit ? (showZoneStatusLabels or showFvgQualityLabels) : isNormal ? showFvgQualityLabels : false
effectiveShowStructure = (isDebug or isAudit) ? showStructure : isNormal ? showStructure : false
effectiveReactionMode = isClean ? "Close outside zone" : reactionMode
effectiveShowContextBadge = showContextBadge
showFvgEffective = showFvg and not showOnlyOb
showSweepsEffective = showSweeps and sweepDisplay != "Off"
showLiquidityEffective = showLiquidity and not showOnlyOb
showMidpointsEffective = showMidpoints and midpointDisplay != "Off" and (midpointDisplay != "Debug only" or isDebug)

f_safeDiv(float numerator, float denominator, float fallback) =>
    denominator != 0.0 ? numerator / denominator : fallback

f_boolText(bool value) =>
    value ? "Y" : "N"

f_legendTextSize() =>
    legendTextSizeInput == "Normal" ? size.normal : legendTextSizeInput == "Small" ? size.small : size.tiny

f_qualityVerdict(bool hasDisplacement, bool sizeStrong, bool formedAfterBos, bool trapRisk) =>
    string verdict = "WEAK"
    int passed = 0
    passed += hasDisplacement ? 1 : 0
    passed += sizeStrong ? 1 : 0
    passed += formedAfterBos ? 1 : 0
    verdict := trapRisk ? "TRAP_RISK" : passed >= 3 ? "STRONG" : passed >= 2 ? "ACCEPTABLE" : "WEAK"
    verdict

f_qualityFlags(bool hasDisplacement, bool sizeStrong, bool formedAfterBos, bool trapRisk) =>
    string flags = ""
    flags += hasDisplacement ? "DISPLACEMENT " : "WEAK_DISPLACEMENT "
    flags += sizeStrong ? "SIZE_OK " : "SMALL_GAP "
    flags += formedAfterBos ? "AFTER_BOS " : "NO_BOS "
    flags += trapRisk ? "NEAR_BARRIER " : ""
    flags

f_shouldRenderFvg(string verdict) =>
    bool render = false
    render := (isDebug or isAudit or zoneVisibilityMode == "Debug all detected") ? true : zoneVisibilityMode == "All valid" ? true : (verdict == "STRONG" or verdict == "ACCEPTABLE")
    render

f_legendPosition() =>
    legendPositionInput == "Top left" ? position.top_left : legendPositionInput == "Bottom right" ? position.bottom_right : legendPositionInput == "Bottom left" ? position.bottom_left : position.top_right

f_zoneLabelText(string kind, bool bull, string status, string verdict, string flags, int touchCount, float mitigationPct) =>
    string objectName = kind == "FVG" ? (bull ? "B-FVG" : "S-FVG") : (bull ? "B-OB" : "S-OB")
    string txt = objectName
    if kind == "FVG" and (isDebug or showFvgQualityLabels)
        txt += " " + verdict
    if kind == "OB" and showObLabels
        txt += " " + status
    if isDebug
        txt += "\n" + status
        txt += "\nTouches: " + str.tostring(touchCount)
        txt += " Mit: " + str.tostring(math.round(mitigationPct * 100.0)) + "%"
        if kind == "FVG"
            txt += "\n" + flags
    txt

//──────────────────────────────────────────────────────────────────────────────
// Zone model
//──────────────────────────────────────────────────────────────────────────────
type SmiZone
    box rect
    line midLine
    label tag

    float low
    float high
    float mid

    bool bull
    bool invalidated
    bool touched
    bool midpointTouched
    bool reacted

    string kind

    int createdBar
    int lastTouchedBar

    // Lifecycle/freshness metadata.
    int touchCount
    int firstTouchedBar
    float deepestMitigationPrice
    float mitigationPct

    // Primitive FVG quality metadata.
    float gapAtrMultiple
    float bodyToRangeRatio
    float middleRangeAtrMultiple
    float closeLocationPct

    bool hasDisplacement
    bool formedAfterBos
    int candlesAfterBos

    string qualityVerdict
    string qualityFlags

var SmiZone[] fvgZones = array.new<SmiZone>()
var SmiZone[] obZones = array.new<SmiZone>()
var line[] liquidityLines = array.new_line()
var label[] chartLabels = array.new_label()

// Cumulative visibility counters for legend/audit. They explain detected vs visible.
var int fvgDetectedTotal = 0
var int fvgVisibleTotal = 0
var int fvgHiddenQualityTotal = 0
var int obDetectedTotal = 0
var int obVisibleTotal = 0
var int zonesHiddenInvalidTotal = 0
var int zonesHiddenMitigatedTotal = 0
var int zonesHiddenAgeTotal = 0

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var float previousSwingHigh = na
var float previousSwingLow = na
var bool highBroken = false
var bool lowBroken = false
var bool lastHighSwept = false
var bool lastLowSwept = false
var int lastBullObOriginBar = na
var int lastBearObOriginBar = na
var int structureBias = 0

// Last visible BOS relation. Used only as quality metadata for new FVGs.
var int lastBosBar = na
var int lastBosDir = 0

//──────────────────────────────────────────────────────────────────────────────
// Drawing helpers
//──────────────────────────────────────────────────────────────────────────────
f_deleteZone(SmiZone z) =>
    box.delete(z.rect)
    if not na(z.midLine)
        line.delete(z.midLine)
    if not na(z.tag)
        label.delete(z.tag)

f_trimLabels() =>
    while array.size(chartLabels) > maxLabels
        oldLabel = array.shift(chartLabels)
        label.delete(oldLabel)

f_addLabel(int x, float y, string labelText, color bg, color textColor, style) =>
    newLabel = label.new(x = x, y = y, text = labelText, style = style, color = bg, textcolor = textColor, size = size.tiny)
    array.push(chartLabels, newLabel)
    f_trimLabels()
    newLabel

f_addLiquidityLine(float level, bool buySide, int x) =>
    if showLiquidityEffective
        levelLine = line.new(x1 = x, y1 = level, x2 = bar_index, y2 = level, color = color.new(buySide ? color.red : color.green, 35), style = line.style_dashed)
        array.push(liquidityLines, levelLine)
        while array.size(liquidityLines) > maxLiquidityLevels
            oldLine = array.shift(liquidityLines)
            line.delete(oldLine)

f_updateLiquidityLines() =>
    if showLiquidityEffective and liquidityLineMode == "Active" and array.size(liquidityLines) > 0
        for i = 0 to array.size(liquidityLines) - 1
            liquidityLine = array.get(liquidityLines, i)
            line.set_x2(liquidityLine, bar_index)

f_trimZones(SmiZone[] zones, int maxCount) =>
    while array.size(zones) > maxCount
        oldZone = array.shift(zones)
        f_deleteZone(oldZone)

f_qualityColor(string verdict, bool bull) =>
    color base = bull ? bullFvgColor : bearFvgColor
    color out = base
    out := verdict == "STRONG" ? color.new(base, 82) : verdict == "ACCEPTABLE" ? color.new(base, 88) : verdict == "TRAP_RISK" ? color.new(trapRiskColor, 86) : color.new(weakZoneColor, 90)
    out

f_qualityBorderColor(string verdict, bool bull) =>
    color base = bull ? bullFvgColor : bearFvgColor
    color out = base
    out := verdict == "STRONG" ? color.new(base, 18) : verdict == "ACCEPTABLE" ? color.new(base, 42) : verdict == "TRAP_RISK" ? color.new(trapRiskColor, 15) : color.new(weakZoneColor, 45)
    out

f_addZone(SmiZone[] zones, int maxCount, string kind, bool bull, int leftBar, float zoneLow, float zoneHigh, string qualityVerdict, string qualityFlags, float gapAtrMultiple, float bodyToRangeRatio, float middleRangeAtrMultiple, float closeLocationPct, bool hasDisplacement, bool formedAfterBos, int candlesAfterBos) =>
    color obBaseColor = bull ? bullObColor : bearObColor
    zoneBoxColor = kind == "FVG" ? f_qualityColor(qualityVerdict, bull) : color.new(obBaseColor, 88)
    zoneBorderColor = kind == "FVG" ? f_qualityBorderColor(qualityVerdict, bull) : color.new(obBaseColor, 0)
    zoneBox = box.new(left = leftBar, top = zoneHigh, right = bar_index, bottom = zoneLow, bgcolor = zoneBoxColor, border_color = zoneBorderColor)
    midpoint = (zoneLow + zoneHigh) / 2.0
    bool midpointAllowed = showMidpointsEffective and (midpointDisplay == "All active" or isDebug or (kind == "FVG" and qualityVerdict == "STRONG"))
    midpointLine = midpointAllowed ? line.new(x1 = leftBar, y1 = midpoint, x2 = bar_index, y2 = midpoint, color = color.new(color.gray, 35), style = line.style_dotted) : na
    initialText = f_zoneLabelText(kind, bull, "PINE_CONTEXT_ONLY", qualityVerdict, qualityFlags, 0, 0.0)
    bool shouldShowLabel = kind == "OB" ? showObLabels : effectiveShowZoneStatusLabels
    zoneLabel = shouldShowLabel ? label.new(x = bar_index, y = zoneHigh, text = initialText, style = label.style_label_left, color = zoneBorderColor, textcolor = color.white, size = size.tiny) : na
    zone = SmiZone.new(zoneBox, midpointLine, zoneLabel, zoneLow, zoneHigh, midpoint, bull, false, false, false, false, kind, bar_index, na, 0, na, na, 0.0, gapAtrMultiple, bodyToRangeRatio, middleRangeAtrMultiple, closeLocationPct, hasDisplacement, formedAfterBos, candlesAfterBos, qualityVerdict, qualityFlags)
    array.push(zones, zone)
    f_trimZones(zones, maxCount)

f_updateZoneMitigation(SmiZone zone) =>
    float zoneRange = zone.high - zone.low
    float deepest = zone.deepestMitigationPrice
    float mitigation = zone.mitigationPct
    if zoneRange > 0
        if zone.bull
            deepest := na(deepest) ? low : math.min(deepest, low)
            mitigation := math.max(0.0, math.min(1.0, (zone.high - deepest) / zoneRange))
        else
            deepest := na(deepest) ? high : math.max(deepest, high)
            mitigation := math.max(0.0, math.min(1.0, (deepest - zone.low) / zoneRange))
    [deepest, mitigation]

f_updateZones(SmiZone[] zones) =>
    midpointTouchedNow = false
    invalidatedNow = false
    reactionNow = false

    if array.size(zones) > 0
        zoneCount = array.size(zones)
        for step = 0 to zoneCount - 1
            i = zoneCount - 1 - step
            zone = array.get(zones, i)

            box.set_right(zone.rect, bar_index)
            if not na(zone.midLine)
                line.set_x2(zone.midLine, bar_index)
            if not na(zone.tag)
                label.set_x(zone.tag, bar_index)

            eligibleForLifecycle = bar_index > zone.createdBar
            touchedNow = eligibleForLifecycle and confirmedBar and not zone.invalidated and high >= zone.low and low <= zone.high
            midNow = touchedNow and high >= zone.mid and low <= zone.mid
            touchBarForReaction = touchedNow ? bar_index : zone.lastTouchedBar
            recentTouch = not na(touchBarForReaction) and bar_index - touchBarForReaction <= reactionMaxBars

            bullReactionMidpoint = recentTouch and close > zone.mid and close > open and close > zone.low
            bearReactionMidpoint = recentTouch and close < zone.mid and close < open and close < zone.high
            bullReactionOutside = recentTouch and close > zone.high and close > open
            bearReactionOutside = recentTouch and close < zone.low and close < open
            bullReaction = effectiveReactionMode == "Close outside zone" ? bullReactionOutside : bullReactionMidpoint
            bearReaction = effectiveReactionMode == "Close outside zone" ? bearReactionOutside : bearReactionMidpoint

            // Default invalidation: close beyond edge. Close inside zone is mitigation, not invalidation.
            invalidNow = eligibleForLifecycle and confirmedBar and not zone.invalidated and (zone.bull ? close < zone.low : close > zone.high)
            reactedNow = eligibleForLifecycle and confirmedBar and not zone.invalidated and not zone.reacted and (zone.bull ? bullReaction : bearReaction)

            if touchedNow
                if zone.touchCount == 0
                    zone.firstTouchedBar := bar_index
                zone.touchCount += 1
                zone.touched := true
                zone.lastTouchedBar := bar_index
                [deepest, mitigation] = f_updateZoneMitigation(zone)
                zone.deepestMitigationPrice := deepest
                zone.mitigationPct := mitigation

            if midNow
                zone.midpointTouched := true
                midpointTouchedNow := true

            if reactedNow
                zone.reacted := true
                reactionNow := true
                if not na(zone.tag)
                    label.set_text(zone.tag, f_zoneLabelText(zone.kind, zone.bull, "PINE_REACTION_OBSERVED", zone.qualityVerdict, zone.qualityFlags, zone.touchCount, zone.mitigationPct))

            if touchedNow and not reactedNow and not na(zone.tag)
                label.set_text(zone.tag, f_zoneLabelText(zone.kind, zone.bull, "PINE_RETURNED", zone.qualityVerdict, zone.qualityFlags, zone.touchCount, zone.mitigationPct))

            bool removedZone = false
            if invalidNow
                zone.invalidated := true
                invalidatedNow := true
                if effectiveShowInvalidated
                    box.set_bgcolor(zone.rect, color.new(weakZoneColor, 88))
                    box.set_border_color(zone.rect, color.new(weakZoneColor, 45))
                    if not na(zone.midLine)
                        line.set_color(zone.midLine, color.new(weakZoneColor, 55))
                    if not na(zone.tag)
                        label.set_text(zone.tag, f_zoneLabelText(zone.kind, zone.bull, "PINE_INVALIDATED", zone.qualityVerdict, zone.qualityFlags, zone.touchCount, zone.mitigationPct))
                        label.set_color(zone.tag, color.new(weakZoneColor, 60))
                else
                    f_deleteZone(zone)
                    array.remove(zones, i)
                    removedZone := true

            bool keepBecauseStrong = keepStrongZonesBeyondMaxAge and zone.kind == "FVG" and zone.qualityVerdict == "STRONG" and not zone.invalidated and zone.mitigationPct < mitigatedThresholdPct
            bool expiredByAge = not removedZone and not isDebug and not isAudit and maxZoneAgeBars > 0 and bar_index - zone.createdBar > maxZoneAgeBars and not keepBecauseStrong
            bool hiddenMitigated = not removedZone and not isDebug and not isAudit and not showMitigatedZones and zone.touched and zone.mitigationPct >= mitigatedThresholdPct
            if expiredByAge or hiddenMitigated
                f_deleteZone(zone)
                array.remove(zones, i)
                removedZone := true

            if not removedZone
                array.set(zones, i, zone)

    [midpointTouchedNow, invalidatedNow, reactionNow]

f_findBullObOffset(int maxBack) =>
    int found = na
    for i = 1 to maxBack
        if na(found) and close[i] < open[i]
            found := i
    found

f_findBearObOffset(int maxBack) =>
    int found = na
    for i = 1 to maxBack
        if na(found) and close[i] > open[i]
            found := i
    found

//──────────────────────────────────────────────────────────────────────────────
// Swing structure
//──────────────────────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

if confirmedBar and not na(ph)
    previousSwingHigh := lastSwingHigh
    lastSwingHigh := ph
    lastSwingHighBar := bar_index - swingLen
    highBroken := false
    lastHighSwept := false
    f_addLiquidityLine(lastSwingHigh, true, lastSwingHighBar)
    if effectiveShowSwingLabels
        swingText = not na(previousSwingHigh) and lastSwingHigh > previousSwingHigh ? "HH" : "LH"
        f_addLabel(lastSwingHighBar, lastSwingHigh, swingText, color.new(color.red, 65), color.white, label.style_label_down)

if confirmedBar and not na(pl)
    previousSwingLow := lastSwingLow
    lastSwingLow := pl
    lastSwingLowBar := bar_index - swingLen
    lowBroken := false
    lastLowSwept := false
    f_addLiquidityLine(lastSwingLow, false, lastSwingLowBar)
    if effectiveShowSwingLabels
        swingText = not na(previousSwingLow) and lastSwingLow > previousSwingLow ? "HL" : "LL"
        f_addLabel(lastSwingLowBar, lastSwingLow, swingText, color.new(color.green, 65), color.white, label.style_label_up)

bosBull = confirmedBar and not na(lastSwingHigh) and not highBroken and close > lastSwingHigh
bosBear = confirmedBar and not na(lastSwingLow) and not lowBroken and close < lastSwingLow
chochBull = bosBull and structureBias < 0
chochBear = bosBear and structureBias > 0

if bosBull
    highBroken := true
    structureBias := 1
    lastBosBar := bar_index
    lastBosDir := 1
    if effectiveShowStructure
        f_addLabel(bar_index, high, chochBull ? "CHoCH up" : "BOS up", color.new(color.green, 45), color.white, label.style_label_up)

if bosBear
    lowBroken := true
    structureBias := -1
    lastBosBar := bar_index
    lastBosDir := -1
    if effectiveShowStructure
        f_addLabel(bar_index, low, chochBear ? "CHoCH down" : "BOS down", color.new(color.red, 45), color.white, label.style_label_down)

//──────────────────────────────────────────────────────────────────────────────
// FVG geometry + primitive quality
//──────────────────────────────────────────────────────────────────────────────
bullFvgGap = bar_index >= 2 ? low - high[2] : na
bearFvgGap = bar_index >= 2 ? low[2] - high : na

minGeometryGap = syminfo.mintick * minGeometryGapTicks

bullFvgGeometry = confirmedBar and showFvgEffective and bar_index >= 2 and high[2] < low and bullFvgGap >= minGeometryGap
bearFvgGeometry = confirmedBar and showFvgEffective and bar_index >= 2 and low[2] > high and bearFvgGap >= minGeometryGap

middleBody = bar_index >= 2 ? math.abs(close[1] - open[1]) : na
middleRange = bar_index >= 2 ? high[1] - low[1] : na
bodyToRangeRatio = not na(middleRange) ? f_safeDiv(middleBody, middleRange, 0.0) : na
middleRangeAtrMultiple = not na(middleRange) and atr > 0 ? middleRange / atr : na
closeLocationPct = not na(middleRange) ? f_safeDiv(close[1] - low[1], middleRange, 0.5) : na

bullDisplacement = bar_index >= 2 and close[1] > open[1] and bodyToRangeRatio >= minBodyToRangeRatio and middleRangeAtrMultiple >= minRangeAtrMultiple and closeLocationPct >= minBullCloseLocationPct
bearDisplacement = bar_index >= 2 and close[1] < open[1] and bodyToRangeRatio >= minBodyToRangeRatio and middleRangeAtrMultiple >= minRangeAtrMultiple and closeLocationPct <= maxBearCloseLocationPct

bullGapAtrMultiple = atr > 0 ? bullFvgGap / atr : na
bearGapAtrMultiple = atr > 0 ? bearFvgGap / atr : na
bullSizeStrong = not na(bullGapAtrMultiple) and bullGapAtrMultiple >= minStrongGapAtr
bearSizeStrong = not na(bearGapAtrMultiple) and bearGapAtrMultiple >= minStrongGapAtr

bullFormedAfterBos = not na(lastBosBar) and lastBosDir == 1 and bar_index - lastBosBar <= maxCandlesAfterBos
bearFormedAfterBos = not na(lastBosBar) and lastBosDir == -1 and bar_index - lastBosBar <= maxCandlesAfterBos
bullCandlesAfterBos = bullFormedAfterBos ? bar_index - lastBosBar : na
bearCandlesAfterBos = bearFormedAfterBos ? bar_index - lastBosBar : na

// Simple visible-barrier flag from current known swings.
bullNearBarrier = useBarrierFlags and not na(lastSwingHigh) and lastSwingHigh > low and ((lastSwingHigh - low) / low) * 100.0 <= barrierMaxDistancePct
bearNearBarrier = useBarrierFlags and not na(lastSwingLow) and lastSwingLow < high and ((high - lastSwingLow) / high) * 100.0 <= barrierMaxDistancePct

bullQualityVerdict = f_qualityVerdict(bullDisplacement, bullSizeStrong, bullFormedAfterBos, bullNearBarrier)
bearQualityVerdict = f_qualityVerdict(bearDisplacement, bearSizeStrong, bearFormedAfterBos, bearNearBarrier)
bullQualityFlags = f_qualityFlags(bullDisplacement, bullSizeStrong, bullFormedAfterBos, bullNearBarrier)
bearQualityFlags = f_qualityFlags(bearDisplacement, bearSizeStrong, bearFormedAfterBos, bearNearBarrier)

bullFvgStrong = bullFvgGeometry and bullQualityVerdict == "STRONG"
bearFvgStrong = bearFvgGeometry and bearQualityVerdict == "STRONG"

bullFvgRenderable = bullFvgGeometry and f_shouldRenderFvg(bullQualityVerdict)
bearFvgRenderable = bearFvgGeometry and f_shouldRenderFvg(bearQualityVerdict)

if bullFvgGeometry
    fvgDetectedTotal += 1
    if bullFvgRenderable
        fvgVisibleTotal += 1
    else
        fvgHiddenQualityTotal += 1

if bearFvgGeometry
    fvgDetectedTotal += 1
    if bearFvgRenderable
        fvgVisibleTotal += 1
    else
        fvgHiddenQualityTotal += 1

if bullFvgRenderable
    f_addZone(fvgZones, maxFvgZones, "FVG", true, bar_index - 2, high[2], low, bullQualityVerdict, bullQualityFlags, bullGapAtrMultiple, bodyToRangeRatio, middleRangeAtrMultiple, closeLocationPct, bullDisplacement, bullFormedAfterBos, bullCandlesAfterBos)

if bearFvgRenderable
    f_addZone(fvgZones, maxFvgZones, "FVG", false, bar_index - 2, high, low[2], bearQualityVerdict, bearQualityFlags, bearGapAtrMultiple, bodyToRangeRatio, middleRangeAtrMultiple, closeLocationPct, bearDisplacement, bearFormedAfterBos, bearCandlesAfterBos)

//──────────────────────────────────────────────────────────────────────────────
// Order block detection
//──────────────────────────────────────────────────────────────────────────────
bullObOffset = bosBull and math.abs(close - open) >= atr * minObDisplacementAtr ? f_findBullObOffset(obLookback) : na
bearObOffset = bosBear and math.abs(close - open) >= atr * minObDisplacementAtr ? f_findBearObOffset(obLookback) : na

if showOb and not na(bullObOffset)
    obDetectedTotal += 1
    obLow = low[bullObOffset]
    obHigh = high[bullObOffset]
    bullOriginBar = bar_index - bullObOffset
    if bullOriginBar != lastBullObOriginBar
        f_addZone(obZones, maxObZones, "OB", true, bullOriginBar, obLow, obHigh, "N/A", "", na, na, na, na, false, false, na)
        obVisibleTotal += 1
        lastBullObOriginBar := bullOriginBar

if showOb and not na(bearObOffset)
    obDetectedTotal += 1
    obLow = low[bearObOffset]
    obHigh = high[bearObOffset]
    bearOriginBar = bar_index - bearObOffset
    if bearOriginBar != lastBearObOriginBar
        f_addZone(obZones, maxObZones, "OB", false, bearOriginBar, obLow, obHigh, "N/A", "", na, na, na, na, false, false, na)
        obVisibleTotal += 1
        lastBearObOriginBar := bearOriginBar

//──────────────────────────────────────────────────────────────────────────────
// Liquidity sweeps. Close-back is required; wick/body and depth are primitive filters.
//──────────────────────────────────────────────────────────────────────────────
body = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

sellSweepDepth = not na(lastSwingLow) ? lastSwingLow - low : na
buySweepDepth = not na(lastSwingHigh) ? high - lastSwingHigh : na
sellSweepDepthPass = not na(sellSweepDepth) and sellSweepDepth >= syminfo.mintick * minSweepDepthTicks
buySweepDepthPass = not na(buySweepDepth) and buySweepDepth >= syminfo.mintick * minSweepDepthTicks
sellWickPass = body > 0 ? lowerWick / body >= minSweepWickToBodyRatio : lowerWick > 0
buyWickPass = body > 0 ? upperWick / body >= minSweepWickToBodyRatio : upperWick > 0

sellSideSweepRaw = confirmedBar and not na(lastSwingLow) and not lastLowSwept and low < lastSwingLow and close > lastSwingLow and sellSweepDepthPass and sellWickPass
buySideSweepRaw = confirmedBar and not na(lastSwingHigh) and not lastHighSwept and high > lastSwingHigh and close < lastSwingHigh and buySweepDepthPass and buyWickPass

if sellSideSweepRaw
    lastLowSwept := true
if buySideSweepRaw
    lastHighSwept := true

sellSideSweep = sellSideSweepRaw and showSweepsEffective and showSellSideSweeps
buySideSweep = buySideSweepRaw and showSweepsEffective and showBuySideSweeps

plotshape(sellSideSweep and sweepDisplay == "Labels", title = "SMI Sell-side Sweep Label", style = shape.triangleup, location = location.belowbar, text = "SSL", color = color.new(sellSideSweepColor, 0), textcolor = color.white, size = size.tiny)
plotshape(buySideSweep and sweepDisplay == "Labels", title = "SMI Buy-side Sweep Label", style = shape.triangledown, location = location.abovebar, text = "BSL", color = color.new(buySideSweepColor, 0), textcolor = color.white, size = size.tiny)
plotshape(sellSideSweep and sweepDisplay == "Markers only", title = "SMI Sell-side Sweep Marker", style = shape.triangleup, location = location.belowbar, color = color.new(sellSideSweepColor, 0), size = size.tiny)
plotshape(buySideSweep and sweepDisplay == "Markers only", title = "SMI Buy-side Sweep Marker", style = shape.triangledown, location = location.abovebar, color = color.new(buySideSweepColor, 0), size = size.tiny)

//──────────────────────────────────────────────────────────────────────────────
// Zone lifecycle
//──────────────────────────────────────────────────────────────────────────────
f_updateLiquidityLines()
[fvgMidpointTouched, fvgInvalidated, fvgReaction] = f_updateZones(fvgZones)
[obMidpointTouched, obInvalidated, obReaction] = f_updateZones(obZones)

//──────────────────────────────────────────────────────────────────────────────
// Primitive visibility badge. This is not a candidate score or trading decision.
//──────────────────────────────────────────────────────────────────────────────
var label contextLabel = na
if confirmedBar and effectiveShowContextBadge and barstate.islast
    string contextText = fvgReaction or obReaction ? "PINE_REACTION_OBSERVED" : bullFvgRenderable or bearFvgRenderable ? "PINE_VALID_QUALITY_ZONE_VISIBLE" : bullFvgGeometry or bearFvgGeometry ? "PINE_FVG_GEOMETRY_HIDDEN_BY_QUALITY" : not na(bullObOffset) or not na(bearObOffset) ? "PINE_OB_VISIBLE" : sellSideSweep or buySideSweep ? "PINE_SWEEP_OBSERVED" : "PINE_CONTEXT_ONLY"
    if isDebug
        contextText += "\nchartTF only | not entry | not trigger"
        contextText += "\nBOS dir=" + str.tostring(lastBosDir) + " bar=" + str.tostring(lastBosBar)
    if na(contextLabel)
        contextLabel := label.new(x = bar_index, y = high, text = contextText, style = label.style_label_left, color = color.new(color.blue, 60), textcolor = color.white, size = size.small)
    else
        label.set_x(contextLabel, bar_index)
        label.set_y(contextLabel, high)
        label.set_text(contextLabel, contextText)

//──────────────────────────────────────────────────────────────────────────────
// Tiny legend. Visual guide only: not entry, not trigger, not risk.
// Default is hidden. Enable from Settings -> Legend -> Show legend.
//──────────────────────────────────────────────────────────────────────────────
var table smiLegend = table.new(f_legendPosition(), 2, 5, border_width = 0)

f_legendRow(int row, string objectText, string meaningText, color swatchColor) =>
    table.cell(smiLegend, 0, row, objectText, bgcolor = swatchColor, text_color = color.white, text_size = f_legendTextSize())
    table.cell(smiLegend, 1, row, meaningText, bgcolor = color.new(color.black, 12), text_color = color.white, text_size = f_legendTextSize())

f_clearLegend() =>
    table.clear(smiLegend, 0, 0, 1, 4)

if barstate.islast
    f_clearLegend()
    if showLegend
        if legendMode == "Tiny"
            f_legendRow(0, "FVG", "green/red imbalance", color.new(color.blue, 45))
            f_legendRow(1, "OB", "cyan/magenta block", color.new(color.purple, 35))
            f_legendRow(2, "SSL/BSL", "▲/▼ sweep", color.new(color.gray, 35))
        else
            f_legendRow(0, "B-FVG / S-FVG", "valid imbalance zones", color.new(color.blue, 40))
            f_legendRow(1, "B-OB / S-OB", "order-block zones", color.new(color.purple, 30))
            f_legendRow(2, "SSL / BSL", "liquidity sweeps", color.new(color.gray, 35))
            f_legendRow(3, "CE", "midpoint only", color.new(color.gray, 50))
            f_legendRow(4, "Visible", "valid + quality", color.new(color.black, 0))

//──────────────────────────────────────────────────────────────────────────────
// Context alerts. These are visual/context alerts only, not entries/triggers.
//──────────────────────────────────────────────────────────────────────────────
alertcondition(bullFvgGeometry, "SMI Bullish FVG geometry detected", "SMI Bullish FVG geometry detected on current chart timeframe. Context only, not entry, not trigger.")
alertcondition(bearFvgGeometry, "SMI Bearish FVG geometry detected", "SMI Bearish FVG geometry detected on current chart timeframe. Context only, not entry, not trigger.")
alertcondition(bullFvgStrong, "SMI Strong Bullish FVG", "SMI Strong Bullish FVG primitive quality on current chart timeframe. Context only, not entry, not trigger.")
alertcondition(bearFvgStrong, "SMI Strong Bearish FVG", "SMI Strong Bearish FVG primitive quality on current chart timeframe. Context only, not entry, not trigger.")
alertcondition(sellSideSweep, "SMI Sell-side Sweep", "SMI Sell-side Sweep on current chart timeframe. Context only, not entry, not trigger.")
alertcondition(buySideSweep, "SMI Buy-side Sweep", "SMI Buy-side Sweep on current chart timeframe. Context only, not entry, not trigger.")
alertcondition(fvgMidpointTouched, "SMI FVG midpoint touched", "SMI FVG midpoint touched on current chart timeframe. Mitigation context only, not invalidation by itself.")
alertcondition(obMidpointTouched, "SMI OB midpoint touched", "SMI Order Block midpoint touched on current chart timeframe. Mitigation context only, not invalidation by itself.")
alertcondition(fvgReaction or obReaction, "SMI Reaction observed", "SMI Reaction observed on current chart timeframe. Context only, not entry, not trigger.")
alertcondition(fvgInvalidated or obInvalidated, "SMI Zone invalidated", "SMI Zone invalidated on current chart timeframe by close beyond zone edge.")
